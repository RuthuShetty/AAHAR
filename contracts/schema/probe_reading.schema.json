{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aahar.ai/contracts/schema/probe_reading",
  "title": "ProbeReading",
  "description": "Immutable time-series reading from a silage probe node. Append-only. 9 parameters from Table 4.2. Ingested via MQTT or BLE relay.",
  "version": 2,
  "type": "object",
  "required": ["bunker_id", "probe_device_id", "ph", "temperatures_c", "moisture_pct", "co2_ppm", "o2_pct", "fermentation_quality_index"],
  "additionalProperties": false,
  "properties": {
    "bunker_id": { "type": "string", "format": "uuid" },
    "probe_device_id": { "type": "string", "pattern": "^AAHAR-S-[0-9]{6}$" },
    "reading_sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonically increasing sequence number per probe. Used to detect gaps."
    },
    "ph": {
      "type": "object",
      "description": "ISFET pH probe reading. Range 3.0–7.5, accuracy ±0.1.",
      "required": ["value", "raw_mv"],
      "properties": {
        "value":   { "type": "number", "minimum": 3.0, "maximum": 7.5 },
        "raw_mv":  { "type": "number", "description": "Raw millivolt output before temperature compensation." },
        "temp_compensated": { "type": "boolean" },
        "calibration_offset": { "type": "number" }
      }
    },
    "temperatures_c": {
      "type": "array",
      "description": "Temperature readings from DS18B20 array at 4 depths. Index 0=surface, 3=deepest.",
      "items": {
        "type": "object",
        "required": ["depth_cm", "value_c"],
        "properties": {
          "depth_cm": { "type": "number", "minimum": 0, "maximum": 200 },
          "value_c":  { "type": "number", "minimum": -10, "maximum": 80 }
        }
      },
      "minItems": 1,
      "maxItems": 4
    },
    "moisture_pct": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value":          { "type": "number", "minimum": 20, "maximum": 85 },
        "capacitive_raw": { "type": ["number","null"] },
        "resistive_raw":  { "type": ["number","null"] }
      }
    },
    "co2_ppm": {
      "type": "object",
      "description": "NDIR CO₂ reading. MH-Z19C. Range 0–10000 ppm, accuracy ±50 ppm.",
      "required": ["value"],
      "properties": {
        "value":  { "type": "number", "minimum": 0, "maximum": 10000 },
        "raw_adc":{ "type": ["integer","null"] }
      }
    },
    "o2_pct": {
      "type": "object",
      "description": "Electrochemical O₂ sensor. Range 0–25%, accuracy ±0.2%.",
      "required": ["value"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 25 }
      }
    },
    "voc": {
      "type": ["object","null"],
      "description": "BME688 MOS array VOC / gas index readings. Relative, indexed.",
      "properties": {
        "gas_resistance_ohm": { "type": "number" },
        "voc_index":          { "type": "number", "minimum": 0, "maximum": 500 },
        "ethanol_rel":        { "type": ["number","null"], "description": "Relative ethanol indication 0–1." },
        "nh3_rel":            { "type": ["number","null"], "description": "Relative NH₃ indication 0–1. High = protein breakdown." }
      }
    },
    "fermentation_quality_index": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Composite score derived from pH trajectory, temp delta, CO₂, VOC. 80–100=excellent, 60–79=good, 40–59=fair, <40=poor."
    },
    "mould_probability": {
      "type": ["number","null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Derived mould growth probability. AUC ≥ 0.86. Null until forecast model has enough history (min 24 h)."
    },
    "spoilage_front_m": {
      "type": ["number","null"],
      "minimum": 0,
      "description": "Estimated aerobic spoilage front position in metres from the feed-out face. Null if face not yet opened."
    },
    "alert_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["HIGH_PH", "TEMP_SPIKE", "O2_INGRESS", "NH3_SPIKE", "LOW_BATTERY", "MOULD_RISK", "CLOSTRIDIAL_RISK"]
      },
      "description": "Active alert conditions at time of reading. Each triggers push/SMS if AlertSeverity=CRITICAL."
    },
    "battery_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "solar_charging": {
      "type": ["boolean","null"]
    },
    "signal": {
      "type": "object",
      "description": "Radio link quality.",
      "properties": {
        "transport": { "type": "string", "enum": ["LORA", "BLE", "WIFI", "STORED"] },
        "rssi_dbm":  { "type": ["integer","null"] },
        "snr_db":    { "type": ["number","null"] }
      }
    }
  }
}
