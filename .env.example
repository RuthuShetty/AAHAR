# ── AAHAR Cloud — copy to .env and fill in. NEVER commit the filled file. ──
# Generate a secret with:  python -c "import secrets;print(secrets.token_urlsafe(48))"

ENVIRONMENT=development           # development | test | staging | production
DEBUG=false
DEV_MODE=false                    # logs the OTP instead of SMS. Never in prod.

# Required in staging/production. Startup FAILS if unset or <32 chars there.
JWT_SECRET=
JWT_ISSUER=aahar-cloud
JWT_AUDIENCE=aahar-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# SQLite is rejected in staging/production.
DATABASE_URL=postgresql+asyncpg://aahar:CHANGE_ME@localhost:5432/aahar
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

# Object storage. 'minioadmin' is rejected in staging/production.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_MEDIA=aahar-media

# Must be OUTSIDE the repository tree.
MEDIA_LOCAL_DIR=/var/lib/aahar/media
MEDIA_MAX_PART_BYTES=8388608
MEDIA_MAX_TOTAL_BYTES=268435456

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_WORKER_ENABLED=false         # run as its own process, not in the API

# Comma-separated. '*' is rejected in staging/production.
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
EXPOSE_API_DOCS=true              # set false in production
